{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DefinitionsIndex",
  "type": "object",
  "required": ["schema_version", "doc_id", "definitions"],
  "properties": {
    "schema_version": { "type": "string" },
    "doc_id": { "type": "string" },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "normalized_term", "segment_id", "definition_evidence_ids", "source_pattern", "confidence"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "normalized_term": { "type": "string" },
          "segment_id": { "type": "string" },
          "anchor_id": { "type": ["integer", "null"] },
          "term_evidence_id": { "type": ["string", "null"] },
          "definition_evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "page_numbers": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "source_pattern": {
            "type": "string",
            "enum": ["quoted", "markdown_bold", "title_case", "lr_clause", "no_match"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
