{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SegmentMap",
  "type": "object",
  "required": ["schema_version", "doc_id", "segments", "precedence"],
  "properties": {
    "schema_version": { "type": "string" },
    "doc_id": { "type": "string" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "kind", "page_range", "priority", "precedence_rank", "detection"],
        "properties": {
          "segment_id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": [
              "base_lease", "deed_of_variation", "supplemental_deed",
              "licence", "memorandum", "counterpart", "update_pages",
              "prescribed_clauses", "lease_particulars", "underlease",
              "plans", "schedules_only", "contents", "unknown"
            ]
          },
          "title": { "type": "string" },
          "page_range": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "minItems": 2,
            "maxItems": 2
          },
          "start_evidence_id": { "type": ["string", "null"] },
          "end_evidence_id": { "type": ["string", "null"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "priority": {
            "type": "string",
            "enum": ["highest", "high", "standard", "base", "supplemental", "nav"]
          },
          "precedence_rank": { "type": "integer", "minimum": 0 },
          "supersedes_segment_ids": { "type": "array", "items": { "type": "string" } },
          "detection": {
            "type": "object",
            "properties": {
              "method": { "type": "string" },
              "signals": { "type": "array", "items": { "type": "string" } },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "precedence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
