{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SemanticSectionMap",
  "type": "object",
  "required": ["schema_version", "doc_id", "segments"],
  "properties": {
    "schema_version": { "type": "string" },
    "doc_id": { "type": "string" },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["segment_id", "topics"],
        "properties": {
          "segment_id": { "type": "string" },
          "topics": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["title", "segment_id", "evidence_ids", "confidence", "method"],
              "properties": {
                "title": { "type": "string" },
                "segment_id": { "type": "string" },
                "pages": { "type": "array", "items": { "type": "integer" } },
                "start_evidence_id": { "type": ["string", "null"] },
                "end_evidence_id": { "type": ["string", "null"] },
                "evidence_ids": { "type": "array", "items": { "type": "string" } },
                "structure_anchor_ids": { "type": "array", "items": { "type": "string" } },
                "definition_terms": { "type": "array", "items": { "type": "string" } },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "method": { "type": "string" },
                "warnings": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
